{
  "name": "MO_TEST",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "MO_TEST 웹 앱",
      "onAutoForward": "openPreview",
      "visibility": "public"
    }
  },
  "postCreateCommand": "python -m venv .venv && .venv/bin/python -m pip install -r requirements.txt",
  "postStartCommand": "bash .devcontainer/start-server.sh",
  "postAttachCommand": "bash .devcontainer/start-server.sh"
}
